<?xml version="1.0" encoding="utf-8"?>
<!--
  EC66 Phase-1 physics proxy.
  Joint frames, moving-link masses and inertias are based on the public Elite
  Robots EC66 URDF. Visual/collision primitives are deliberately simplified.
  The 1 kg scoop mass is provisional and MUST be replaced by a measurement
  before force/torque results are treated as calibrated.
-->
<robot name="ec66_simplified">
  <material name="ec66_white"><color rgba="0.81 0.84 0.85 1"/></material>
  <material name="ec66_steel"><color rgba="0.45 0.50 0.54 1"/></material>
  <material name="ec66_dark"><color rgba="0.03 0.04 0.05 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0.00039768 0 0.012605"/><mass value="0.41542"/><inertia ixx="0.00054632" ixy="-4.5067e-9" ixz="5.9528e-7" iyy="0.00053741" iyz="-3.5275e-10" izz="0.0010336"/></inertial>
    <visual><origin xyz="0 0 0.048"/><geometry><cylinder radius="0.075" length="0.096"/></geometry><material name="ec66_steel"/></visual>
    <collision><origin xyz="0 0 0.048"/><geometry><cylinder radius="0.075" length="0.096"/></geometry></collision>
  </link>

  <link name="link1">
    <inertial><origin xyz="0 0.0082614 0.0028405"/><mass value="1.7827"/><inertia ixx="0.0031691" ixy="-1.2175e-7" ixz="2.8351e-8" iyy="0.0029334" iyz="-0.00037927" izz="0.0035086"/></inertial>
    <visual><geometry><sphere radius="0.063"/></geometry><material name="ec66_white"/></visual>
    <collision><geometry><sphere radius="0.063"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute"><origin xyz="0 0 0.096"/><parent link="base_link"/><child link="link1"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="150" velocity="2.6199"/><dynamics damping="0.1" friction="0.02"/></joint>

  <link name="link2">
    <inertial><origin xyz="0 0.017318 0.17637"/><mass value="4.8843"/><inertia ixx="0.022101" ixy="1.2727e-7" ixz="1.0833e-7" iyy="0.022526" iyz="-0.00021178" izz="0.0066105"/></inertial>
    <visual><origin xyz="0 0 0.209"/><geometry><cylinder radius="0.050" length="0.418"/></geometry><material name="ec66_white"/></visual>
    <collision><origin xyz="0 0 0.209"/><geometry><cylinder radius="0.050" length="0.418"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute"><origin xyz="0 0.122 0" rpy="0 1.5708 0"/><parent link="link1"/><child link="link2"/><axis xyz="0 1 0"/><limit lower="-6.2832" upper="6.2832" effort="150" velocity="2.6199"/><dynamics damping="0.1" friction="0.02"/></joint>

  <link name="link3">
    <inertial><origin xyz="0 0.028008 0.20069"/><mass value="2.1495"/><inertia ixx="0.0091566" ixy="-1.4815e-7" ixz="-2.8912e-8" iyy="0.0091573" iyz="7.3471e-5" izz="0.0015747"/></inertial>
    <visual><origin xyz="0 0 0.199"/><geometry><cylinder radius="0.043" length="0.398"/></geometry><material name="ec66_white"/></visual>
    <collision><origin xyz="0 0 0.199"/><geometry><cylinder radius="0.043" length="0.398"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute"><origin xyz="0 -0.122 0.418"/><parent link="link2"/><child link="link3"/><axis xyz="0 1 0"/><limit lower="-2.7925" upper="2.7925" effort="150" velocity="3.3161"/><dynamics damping="0.08" friction="0.015"/></joint>

  <link name="link4">
    <inertial><origin xyz="0 0.11599 -0.00070291"/><mass value="0.53436"/><inertia ixx="0.00041486" ixy="1.1841e-9" ixz="4.7177e-9" iyy="0.00037669" iyz="-5.8283e-5" izz="0.0004403"/></inertial>
    <visual><origin xyz="0 0.061 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.038" length="0.122"/></geometry><material name="ec66_white"/></visual>
    <collision><origin xyz="0 0.061 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.038" length="0.122"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute"><origin xyz="0 0 0.398" rpy="0 1.5708 0"/><parent link="link3"/><child link="link4"/><axis xyz="0 1 0"/><limit lower="-6.2832" upper="6.2832" effort="28" velocity="4.5379"/><dynamics damping="0.05" friction="0.01"/></joint>

  <link name="link5">
    <inertial><origin xyz="0 0.00070291 0.091994"/><mass value="0.53436"/><inertia ixx="0.00041486" ixy="-4.6787e-9" ixz="1.1523e-9" iyy="0.0004403" iyz="5.8283e-5" izz="0.00037669"/></inertial>
    <visual><origin xyz="0 0 0.049"/><geometry><cylinder radius="0.036" length="0.098"/></geometry><material name="ec66_white"/></visual>
    <collision><origin xyz="0 0 0.049"/><geometry><cylinder radius="0.036" length="0.098"/></geometry></collision>
  </link>
  <joint name="joint5" type="revolute"><origin xyz="0 0.122 0"/><parent link="link4"/><child link="link5"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" effort="28" velocity="4.5379"/><dynamics damping="0.04" friction="0.008"/></joint>

  <link name="link6">
    <inertial><origin xyz="0 -0.067831 0"/><mass value="0.16488"/><inertia ixx="7.7869e-5" ixy="1.9128e-10" ixz="-3.3406e-10" iyy="0.00011744" iyz="-7.8331e-8" izz="7.757e-5"/></inertial>
    <visual><origin xyz="0 -0.0445 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.034" length="0.089"/></geometry><material name="ec66_white"/></visual>
    <collision><origin xyz="0 -0.0445 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.034" length="0.089"/></geometry></collision>
  </link>
  <joint name="joint6" type="revolute"><origin xyz="0 0 0.098"/><parent link="link5"/><child link="link6"/><axis xyz="0 -1 0"/><limit lower="-6.2832" upper="6.2832" effort="28" velocity="4.5379"/><dynamics damping="0.03" friction="0.006"/></joint>

  <link name="flange_link">
    <visual><origin xyz="0 0 0.005"/><geometry><cylinder radius="0.038" length="0.010"/></geometry><material name="ec66_steel"/></visual>
    <collision><origin xyz="0 0 0.005"/><geometry><cylinder radius="0.038" length="0.010"/></geometry></collision>
  </link>
  <joint name="flange_joint" type="fixed"><origin xyz="0 -0.089 -0.00047661" rpy="-1.5708 0 3.1416"/><parent link="link6"/><child link="flange_link"/></joint>

  <link name="scoop_link">
    <inertial><origin xyz="0.40 0 -0.02"/><mass value="1.0"/><inertia ixx="0.011" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.029"/></inertial>
    <visual><origin xyz="0.415 0 -0.025"/><geometry><box size="0.43 0.36 0.012"/></geometry><material name="ec66_steel"/></visual>
    <collision><origin xyz="0.415 0 -0.025"/><geometry><box size="0.43 0.36 0.012"/></geometry></collision>
    <visual><origin xyz="0.415 0.174 0.025"/><geometry><box size="0.43 0.012 0.10"/></geometry><material name="ec66_steel"/></visual>
    <collision><origin xyz="0.415 0.174 0.025"/><geometry><box size="0.43 0.012 0.10"/></geometry></collision>
    <visual><origin xyz="0.415 -0.174 0.025"/><geometry><box size="0.43 0.012 0.10"/></geometry><material name="ec66_steel"/></visual>
    <collision><origin xyz="0.415 -0.174 0.025"/><geometry><box size="0.43 0.012 0.10"/></geometry></collision>
    <visual><origin xyz="0.12 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.018" length="0.25"/></geometry><material name="ec66_dark"/></visual>
  </link>
  <joint name="scoop_mount" type="fixed"><origin xyz="0 0 0" rpy="0 -1.5708 0"/><parent link="flange_link"/><child link="scoop_link"/></joint>
</robot>
